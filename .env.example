# Never commit this file. Copy it to .env and fill in the value.
GEMINI_API_KEY=replace_with_your_google_ai_studio_key
PORT=8787
# Set this to the exact frontend origin in production, for example:
# FRONTEND_ORIGIN=https://sixplanetstales-lang.github.io
FRONTEND_ORIGIN=http://localhost:8787
GEMINI_MODEL=gemini-2.0-flash
